# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# Replace with your actual MongoDB Atlas cluster connection string
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_agentic_commerce?retryWrites=true&w=majority

# ============================================================
# AUTHENTICATION & SECURITY
# Generate strong, random secrets for production
# ============================================================
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_change_in_production

# ============================================================
# RAZORPAY TEST MODE CREDENTIALS
# Obtain from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# (Make sure you are in TEST MODE)
# ============================================================
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# ============================================================
# AI / LLM CONFIGURATION (Optional - Fallback Engine Active)
# Provide your Gemini API key (or OpenAI compatible key)
# If left empty, platform automatically runs high-precision deterministic intent engine!
# ============================================================
GEMINI_API_KEY=
# or OPENAI_API_KEY=

# ============================================================
# OPTIONAL EMAIL SERVICE
# For actual external email delivery (Draft mode works without keys)
# ============================================================
EMAIL_API_KEY=
EMAIL_FROM=orders@nexcommerce.store
