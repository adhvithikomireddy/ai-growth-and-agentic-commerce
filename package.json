{
  "name": "ai-growth-and-agentic-commerce",
  "version": "1.0.0",
  "description": "Autonomous AI-Native Agentic Commerce & Merchant Revenue Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "seed": "npm run seed --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "razorpay",
    "agentic-commerce",
    "ai-agents",
    "a2a",
    "fintech"
  ],
  "author": "Adhvithi Komireddy",
  "license": "MIT"
}
